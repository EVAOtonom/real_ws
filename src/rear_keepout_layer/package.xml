<?xml version="1.0"?>
<package format="3">
  <name>rear_keepout_layer</name>
  <version>0.1.0</version>
  <description>Dynamic U-shaped rear keepout costmap layer for Nav2 Ackermann vehicles.</description>

  <maintainer email="user@example.com">EVA Otonom</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <costmap_2d plugin="${prefix}/rear_keepout_layer.xml" />
  </export>
</package>
