      <inertial><mass>0.1</mass><origin xyz="0 0 0" rpy="0 0 0" /><inertia><ixx>0.0002</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0002</iyy><iyz>0</iyz><izz>0.0002</izz></inertia></inertial>
