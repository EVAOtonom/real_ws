<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.8">

  <model name="Evata">
    <pose>0 0 0 0 0 0</pose>
    <link name="base_footprint" />

   
    <link name="base_link">
      <inertial>
        <mass>150</mass>
        <inertia>
          <ixx>0.166667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.166667</iyy>
          <iyz>0</iyz>
          <izz>0.166667</izz>
        </inertia>
        <pose>0 0 0 0 -0 0</pose>
      </inertial>
      <pose>0 0 -0.16 0 -0 1.57</pose>
    </link>

    <joint name="base_joint" type="fixed">
      <pose>0 0 0 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>


    <link name="new_front_right_wheel">
      <pose>0.76 -0.48 0.04 0 0 1.57</pose>
      <inertial><mass>1</mass><inertia><ixx>0.166667</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.166667</iyy><iyz>0</iyz><izz>0.166667</izz></inertia><pose>0 0 0 0 0 0</pose></inertial>
    </link>

    <link name="new_front_left_wheel">
