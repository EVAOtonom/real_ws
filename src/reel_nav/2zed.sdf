    </link>

    <joint name="new_front_right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>new_front_right_wheel</child>
      <pose>0 0 0 0 0 0</pose> <axis>
        <xyz>1 0 0</xyz> <limit>
          <lower>-1.79769e+308</lower>
          <upper>1.79769e+308</upper>
          <effort>-1</effort> 
          <velocity>-1</velocity>
        </limit>
      </axis>
    </joint>

    <joint name="new_front_left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>new_front_left_wheel</child>
      <pose>0 0 0 0 0 0</pose>
      <axis>
