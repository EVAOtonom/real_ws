<?xml version="1.0"?>
<package format="3">
  <name>evata_nav_guard</name>
  <version>0.1.0</version>
  <description>EVATA sensor watchdog, cmd_vel safety gate and Nav2 goal-preserving BT pause gate.</description>
  <maintainer email="user@example.com">EVATA</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav2_behavior_tree</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
